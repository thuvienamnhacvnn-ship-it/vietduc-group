# ---------------------------------------------------------------- database
# Leave DATABASE_URL empty to use PGlite (Postgres compiled to WASM) in
# ./data/pgdata - no database server required. Set it to a real Postgres
# connection string in production; the schema and every query are plain
# Postgres and run unchanged on both.
#
# IMPORTANT for PGlite: the data directory belongs to one process at a time.
# Stop `npm run dev` before running db:push, seed, ingest or kb:build.
DATABASE_URL=
PGLITE_DATA_DIR=

# ------------------------------------------------------------------- site
# Absolute origin, used for canonical URLs, Open Graph, the sitemap and the QR
# codes on programme pages. Editors can also set this in Admin → Cấu hình.
NEXT_PUBLIC_SITE_URL=https://vietducgroup.com.vn

# --------------------------------------------------------------- AI advisor
# All three are optional. With no provider the advisor still retrieves and
# cites approved documents, and says plainly that generated answers are off.
# Never put these in NEXT_PUBLIC_* - they are server-side only.
#
# AI_PROVIDER: anthropic | openai | gemini
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Embeddings turn retrieval from lexical-only into hybrid lexical + vector.
# Optional: without them the BM25 retriever is used, which needs no service.
# EMBEDDING_PROVIDER: openai | gemini
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ------------------------------------------------------------------- email
# Without a provider the site never claims an email was sent: the newsletter
# reports that confirmation is pending and lead alerts are skipped.
# EMAIL_PROVIDER: resend
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="Việt Đức Group <tuyensinh@vietducgroup.com.vn>"
ADMIN_NOTIFY_EMAIL=

# --------------------------------------------------------------- documents
# Uploaded PDFs are stored here, outside /public, and are never served
# directly. Defaults to ./storage/documents.
DOCUMENT_STORAGE_DIR=

# OCR language data. tesseract.js downloads vie+deu+eng on first use; point
# these at a local directory to run the pipeline offline.
TESSERACT_LANG_PATH=
TESSERACT_CACHE_PATH=

# ------------------------------------------------------- first admin user
# Read by `npm run seed` to create or reset the first administrator.
# Use them once, then remove them from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ------------------------------------------------------- social channels
# The group's own pages. Full URL, except zalo and whatsapp which may be a
# bare phone number. A channel left empty is not drawn: a social icon that
# leads nowhere is worse than no icon, so the row stays hidden until at least
# one of these is set.
#
# The admin screen writes the same values to the settings table, which is the
# right home for them - but a deployment running off the content snapshot has
# its database in memory, so nothing saved there survives the request. On that
# kind of deployment these variables are the only thing that persists, and a
# value set here wins over the stored one.
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=
SOCIAL_ZALO=
SOCIAL_WHATSAPP=
