/.tmpimg
/tmp-*
/_*.mjs

# ảnh thô bóc từ PDF, tái tạo bằng node _harvest.mjs
/_harvest

.vercel
.env*
!.env.example

# Đồ nghề dịch sáu ngôn ngữ: bản bóc chữ, bản dịch thô và các script chạy một
# lần. Bản dịch thật đã nằm trong mã nguồn, mấy file này chỉ là giàn giáo.
/_l10n.json
/_dich/
/scripts/_*.ts

# Ghi chú dành cho công cụ soạn thảo lúc phát triển, không thuộc về sản phẩm.
/CLAUDE.md
/AGENTS.md

